{
  "name": "our-wallet",
  "private": true,
  "description": "Our Wallet - static web app. Run `npm run build:css` after changing Tailwind classes in index.html.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o tailwind.css --minify",
    "test:sheet": "node tests/gas/test-sheet.js && node tests/gas/test-formulas.js",
    "test:e2e": "node tests/gas/e2e.js",
    "test:ui": "node tests/gas/ui-regression.js",
    "test:anim": "node tests/gas/animation.js",
    "test:features": "node tests/gas/features.js",
    "test:motion": "node tests/gas/motion.js",
    "test:graphics": "node tests/gas/graphics.js",
    "test:advanced": "node tests/gas/advanced.js",
    "test:modern": "node tests/gas/modern.js",
    "test:harden": "node tests/gas/harden.js",
    "test:monkey": "node tests/gas/monkey.js",
    "test:monkey-sync": "node tests/gas/monkey-sync.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "hyperformula": "2.7.1"
  }
}
